[Unit]
Description=Avocado Connect Device Daemon
# Ordering only: when the tunnels extension is installed, start after rat so
# the startup probe sees it (otherwise tunnels read as unsupported until the
# 30 s re-probe, e.g. right after an OTA activation). No dependency.
After=network.target avocado-rat.service
Wants=network.target
# Don't start (or restart-loop) until the device has been configured. The
# extension ships config.toml.example, not config.toml — provisioning drops
# the real file in place. Avoid network-online.target here: on multi-NIC
# devices an unplugged port makes wait-online hang.
ConditionPathExists=/etc/avocado-conn/config.toml

[Service]
ExecStartPre=/bin/mkdir -p /var/lib/avocado/connect
ExecStart=/usr/bin/avocado-conn run
Environment=AVOCADO_CONN_CONFIG=/etc/avocado-conn/config.toml
Environment=RUST_LOG=info
Restart=always
RestartSec=5
SyslogIdentifier=avocado-conn

[Install]
WantedBy=multi-user.target
